# ============================================================
# 환경변수 템플릿
# ============================================================

# Django 환경 구분 (local | prod)
DJANGO_ENV=local

# 디버그 모드 (prod에서는 반드시 False)
DEBUG=True

# 허용된 호스트 (쉼표로 구분)
ALLOWED_HOSTS=localhost,127.0.0.1

# Aiven MySQL 연결 정보
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_HOST=careerdotzip-careerdotzip-2cce.l.aivencloud.com
DB_PORT=24815

# Redis 연결 URL — Redis 준비 전 주석 처리
# REDIS_URL=redis://redis:6379/0

# OpenAI API
OPENAI_API_KEY=

# AI Chain Engine (mock | openai)
# 기본값은 mock으로 두고, 실제 OpenAI 호출이 필요할 때만 openai + True로 변경
INTERVIEW_AI_CHAIN_ENGINE=mock
INTERVIEW_AI_OPENAI_MODEL=gpt-4o-mini
INTERVIEW_AI_OPENAI_ENABLE_REAL_CALL=False

# Pinecone Vector DB
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Worknet Open API
# 채용정보 API 인증키만 사용
WORKNET_API_KEY=
WORKNET_BASE_URL=https://www.work24.go.kr/cm/openApi/call/wk/callOpenApiSvcInfo210L01.do

# Django 시크릿 키 (아래 명령어로 생성) - 난수 생성
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# ============================================================
# 배포 시 추가할 부분
# ============================================================
# # Docker Hub 사용자명 (배포용 이미지 이름에 사용)
# DOCKERHUB_USERNAME=

# # 프로덕션 허용 출처 (쉼표로 구분, CORS 설정용)
# CORS_ALLOWED_ORIGINS=
