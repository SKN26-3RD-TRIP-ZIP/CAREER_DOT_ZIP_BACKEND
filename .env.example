# ============================================================
# 환경변수 템플릿
# ============================================================

# Django 환경 구분 (local | prod)
DJANGO_ENV=local

# 디버그 모드 (prod에서는 반드시 False)
DEBUG=True

# 허용된 호스트 (쉼표로 구분)
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 연결 URL
# 형식: mysql://유저:비밀번호@호스트:포트/DB명
DATABASE_URL=

# Redis 연결 URL — Redis 준비 전 주석 처리
# REDIS_URL=redis://redis:6379/0

# OpenAI API
OPENAI_API_KEY=

# LangChain / LangSmith (트레이싱 선택)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=career-dot-zip

# AI Chain Engine (mock | openai)
# 기본값은 mock으로 두고, 실제 OpenAI 호출이 필요할 때만 openai + True로 변경
INTERVIEW_AI_CHAIN_ENGINE=openai
INTERVIEW_AI_OPENAI_MODEL=gpt-4o
INTERVIEW_AI_OPENAI_ENABLE_REAL_CALL=True

# Pinecone Vector DB
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# GitHub (프로젝트 repo 검증용 — 이력서 프로젝트의 GitHub repo 분석)
# 발급: https://github.com/settings/tokens (Fine-grained 권장)
# 권한(최소): 공개 repo만이면 무권한 가능 / 비공개도 분석하려면 Contents·Metadata Read-only
# 없어도 동작하지만 미인증 시 rate limit 60회/시간 (토큰 있으면 5,000회/시간)
GITHUB_TOKEN=

# Worknet Open API
# 채용정보 API 인증키만 사용
WORKNET_API_KEY=
WORKNET_BASE_URL=https://www.work24.go.kr/cm/openApi/call/wk/callOpenApiSvcInfo210L01.do

# Career.zip synthetic Mock Jobs for development and QA
JOBS_PROVIDER=mock
MOCK_JOBS_COUNT=10000
MOCK_JOBS_SEED=2026
# Optional local generated JSON snapshot. Do not commit generated large files.
MOCK_JOBS_DATA_FILE=

# ============================================================
# 이메일(SMTP) 발송 설정
# - 실제 계정/앱비밀번호 등 민감값은 .env(미커밋)에만 입력. 여기엔 키 이름만 둔다.
# - 로컬 개발 기본은 콘솔 출력(console backend). 실제 메일 발송이 필요하면 아래 SMTP 백엔드로 전환.
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# ============================================================
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=
# Gmail SMTP 사용 시 EMAIL_HOST_PASSWORD에는 일반 로그인 비밀번호가 아니라 Gmail 앱 비밀번호를 입력하세요.
# DEFAULT_FROM_EMAIL의 실제 발신 주소는 SMTP 인증 계정과 일치시키는 것을 권장합니다.
# 관리자 신규가입 알림 수신 주소 (미설정 시 알림 생략)
ADMIN_NOTIFICATION_EMAIL=
# 이메일 인증 링크 구성용 프론트 base URL (예: http://localhost:5173)
FRONTEND_BASE_URL=
# 이메일 인증 토큰 만료(초). 미설정 시 기본 86400(24시간)
EMAIL_VERIFICATION_TOKEN_MAX_AGE=
# 이메일 인증번호(6자리 코드) 정책. 미설정 시 기본값 사용.
# TTL 기본 600초(10분) / 최대 시도 5회 / 재발송 쿨다운 60초
EMAIL_CODE_TTL_SECONDS=
EMAIL_CODE_MAX_ATTEMPTS=
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=

# Django 시크릿 키 (아래 명령어로 생성) - 난수 생성
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 반드시 값을 채우세요. 빈 'SECRET_KEY='로 두면 settings의 기본 dev 키를 덮어써
#    'SECRET_KEY must not be empty' 에러로 부팅·테스트가 실패합니다.
SECRET_KEY=

# ============================================================
# 배포 시 추가할 부분
# ============================================================
# # Docker Hub 사용자명 (배포용 이미지 이름에 사용)
# DOCKERHUB_USERNAME=

# # 프로덕션 허용 출처 (쉼표로 구분, CORS 설정용)
# CORS_ALLOWED_ORIGINS=

# # CSRF 신뢰 출처 (운영 HTTPS/크로스도메인. 예: https://app.career.zip)
# CSRF_TRUSTED_ORIGINS=

# # refresh_token 쿠키 보안 (운영 HTTPS 에서 True 권장)
# # 프론트/백 도메인이 다르면 REFRESH_COOKIE_SAMESITE=None + REFRESH_COOKIE_SECURE=True
# REFRESH_COOKIE_SECURE=
# REFRESH_COOKIE_SAMESITE=
# REFRESH_COOKIE_PATH=/
# REFRESH_COOKIE_DOMAIN=
