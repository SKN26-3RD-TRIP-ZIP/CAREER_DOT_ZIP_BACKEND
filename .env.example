# ============================================================
# 환경변수 템플릿
# ============================================================

# Django 환경 구분 (local | prod)
DJANGO_ENV=local

# 디버그 모드 (prod에서는 반드시 False)
DEBUG=True

# 허용된 호스트 (쉼표로 구분)
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 연결 URL
# 형식: mysql://유저:비밀번호@호스트:포트/DB명
DATABASE_URL=

# Redis 공유 캐시 (OAuth 일회용 교환 코드 등). 운영(DEBUG=False)에서는 필수.
#  - 로컬/테스트: 미설정 시 LocMemCache 로 자동 동작(외부 Redis 불필요)
#  - 운영: 반드시 설정. 미설정 시 부팅 단계에서 명확히 실패한다(조용한 LocMem 대체 금지)
#  - 형식: redis://[:password@]host:port/db  (TLS 사용 시 rediss://...)
#  - 예) 로컬 docker:        redis://redis:6379/0
#  - 예) AWS ElastiCache:    rediss://<primary-endpoint>:6379/0   ← 실제 엔드포인트는 .env(.prod)에만
REDIS_URL=
# 캐시 Key 접두어(멀티 환경에서 키 충돌 방지). 미설정 시 'careerzip'
REDIS_KEY_PREFIX=careerzip

# OpenAI API
OPENAI_API_KEY=

# LangChain / LangSmith (트레이싱 선택)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=career-dot-zip
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# AI Chain Engine (mock | openai)
# 기본값은 mock으로 두고, 실제 OpenAI 호출이 필요할 때만 openai + True로 변경
INTERVIEW_AI_CHAIN_ENGINE=openai
INTERVIEW_AI_OPENAI_MODEL=gpt-4o
# OpenAI 요청이 장시간 멈춰 리포트가 processing 상태로 고정되는 것을 방지한다.
INTERVIEW_AI_OPENAI_TIMEOUT_SECONDS=30
INTERVIEW_AI_OPENAI_MAX_RETRIES=1
# Feature-specific Interview AI models.
# Leave unset or set to the same value as INTERVIEW_AI_OPENAI_MODEL to preserve existing behavior.
OPENAI_MODEL_QUESTION_GENERATION=gpt-4o
OPENAI_MODEL_ANSWER_SUFFICIENCY=gpt-4o-mini
OPENAI_MODEL_FOLLOWUP_GENERATION=gpt-4o-mini
INTERVIEW_AI_OPENAI_ENABLE_REAL_CALL=True

# Pinecone Vector DB
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# GitHub (프로젝트 repo 검증용 — 이력서 프로젝트의 GitHub repo 분석)
# 발급: https://github.com/settings/tokens (Fine-grained 권장)
# 권한(최소): 공개 repo만이면 무권한 가능 / 비공개도 분석하려면 Contents·Metadata Read-only
# 없어도 동작하지만 미인증 시 rate limit 60회/시간 (토큰 있으면 5,000회/시간)
GITHUB_TOKEN=

# Worknet Open API
# 채용정보 API 인증키만 사용
WORKNET_API_KEY=
WORKNET_BASE_URL=https://www.work24.go.kr/cm/openApi/call/wk/callOpenApiSvcInfo210L01.do

# Career.zip synthetic Mock Jobs for development and QA
JOBS_PROVIDER=mock
MOCK_JOBS_COUNT=10000
MOCK_JOBS_SEED=2026
# Optional local generated JSON snapshot. Do not commit generated large files.
MOCK_JOBS_DATA_FILE=

# ============================================================
# 이메일(SMTP) 발송 설정
# - 실제 계정/앱비밀번호 등 민감값은 .env(미커밋)에만 입력. 여기엔 키 이름만 둔다.
# - 로컬 개발 기본은 콘솔 출력(console backend). 실제 메일 발송이 필요하면 아래 SMTP 백엔드로 전환.
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# ============================================================
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=
# Gmail SMTP 사용 시 EMAIL_HOST_PASSWORD에는 일반 로그인 비밀번호가 아니라 Gmail 앱 비밀번호를 입력하세요.
# DEFAULT_FROM_EMAIL의 실제 발신 주소는 SMTP 인증 계정과 일치시키는 것을 권장합니다.
# 관리자 신규가입 알림 수신 주소 (미설정 시 알림 생략)
ADMIN_NOTIFICATION_EMAIL=
# 이메일 인증 링크 / OAuth 성공·실패 Redirect 구성용 프론트 base URL (예: http://localhost:5173)
FRONTEND_BASE_URL=
# 소셜 로그인 완료 후 Backend 가 302 로 돌려보낼 Frontend callback 경로 (미설정 시 /oauth/callback)
FRONTEND_OAUTH_CALLBACK_PATH=
# 일회용 OAuth 교환 코드 TTL(초). 미설정 시 기본 120초.
OAUTH_EXCHANGE_CODE_TTL_SECONDS=

# OAuth (Google/Kakao authorization code flow)
# Register redirect URIs in each provider console. Do not put real secrets in Git.
# redirect_uri 는 Backend callback 으로 설정한다.
#   예: GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
#       KAKAO_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/kakao/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=

# OCR provider for image-based JD uploads (leave empty to return ENV_REQUIRED)
OCR_PROVIDER=
OCR_API_KEY=

# 이메일 인증 토큰 만료(초). 미설정 시 기본 86400(24시간)
EMAIL_VERIFICATION_TOKEN_MAX_AGE=
PASSWORD_RESET_TIMEOUT=3600
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
# 이메일 인증번호(6자리 코드) 정책. 미설정 시 기본값 사용.
# TTL 기본 600초(10분) / 최대 시도 5회 / 재발송 쿨다운 60초
EMAIL_CODE_TTL_SECONDS=
EMAIL_CODE_MAX_ATTEMPTS=
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=

# Django 시크릿 키 (아래 명령어로 생성) - 난수 생성
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 반드시 값을 채우세요. 빈 'SECRET_KEY='로 두면 settings의 기본 dev 키를 덮어써
#    'SECRET_KEY must not be empty' 에러로 부팅·테스트가 실패합니다.
SECRET_KEY=

# ============================================================
# 배포 시 추가할 부분
# ============================================================
# # Docker Hub 사용자명 (배포용 이미지 이름에 사용)
# DOCKERHUB_USERNAME=

# # 프로덕션 허용 출처 (쉼표로 구분, CORS 설정용)
# CORS_ALLOWED_ORIGINS=

# # CSRF 신뢰 출처 (운영 HTTPS/크로스도메인. 예: https://app.career.zip)
# CSRF_TRUSTED_ORIGINS=

# # refresh_token 쿠키 보안 (운영 HTTPS 에서 True 권장)
# # 프론트/백 도메인이 다르면 REFRESH_COOKIE_SAMESITE=None + REFRESH_COOKIE_SECURE=True
# REFRESH_COOKIE_SECURE=
# REFRESH_COOKIE_SAMESITE=
# REFRESH_COOKIE_PATH=/
# REFRESH_COOKIE_DOMAIN=

# # 운영 HTTPS 보안 (모두 기본 off. HTTPS 도메인 적용 후 True 로 전환)
# SESSION_COOKIE_SECURE=
# CSRF_COOKIE_SECURE=
# # LB/nginx 가 TLS 종단 + X-Forwarded-Proto 전달 시에만 True
# SECURE_BEHIND_PROXY=
# # http→https 강제(프록시가 이미 처리하면 중복 루프 주의)
# SECURE_SSL_REDIRECT=
# # HSTS (HTTPS 안정화 후에만. 예: 31536000)
# SECURE_HSTS_SECONDS=
# SECURE_HSTS_INCLUDE_SUBDOMAINS=
# SECURE_HSTS_PRELOAD=

# ============================================================
# S3 파일 스토리지 (미디어 파일 영속화)
# AWS_S3_BUCKET_NAME 을 설정하면 자동으로 S3 스토리지가 활성화됩니다.
# 미설정 시 로컬 media/ 폴더에 저장됩니다.
# ============================================================
# AWS_S3_BUCKET_NAME=career-zip-media
# AWS_S3_REGION_NAME=ap-northeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# # 기타 선택 오버라이드 (settings.py 에 안전한 기본값 존재, 로컬 설정 불필요)
# ACCOUNTS_SCHEDULER_ENABLED=false   # runserver 시 휴면/만료 스케줄러 토글
# OPENAI_TTS_MODEL=                  # 미설정 시 코드 기본 TTS 모델 사용
# OPENAI_USE_MOCK=false               # True 면 OpenAI 호출 스킵(키 없는 로컬/CI)
