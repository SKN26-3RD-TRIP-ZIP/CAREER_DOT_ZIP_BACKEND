# ============================================================
# 환경변수 템플릿
# ============================================================

# Django 환경 구분 (local | prod)
DJANGO_ENV=local

# 디버그 모드 (prod에서는 반드시 False)
DEBUG=True

# 허용된 호스트 (쉼표로 구분)
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 연결 URL
# 형식: mysql://유저:비밀번호@호스트:포트/DB명
DATABASE_URL=

# Redis 연결 URL — Redis 준비 전 주석 처리
# REDIS_URL=redis://redis:6379/0

# OpenAI API
OPENAI_API_KEY=

# LangChain / LangSmith (트레이싱 선택)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=career-dot-zip

# AI Chain Engine (mock | openai)
# 기본값은 mock으로 두고, 실제 OpenAI 호출이 필요할 때만 openai + True로 변경
INTERVIEW_AI_CHAIN_ENGINE=mock
INTERVIEW_AI_OPENAI_MODEL=gpt-4o-mini
INTERVIEW_AI_OPENAI_ENABLE_REAL_CALL=False

# Pinecone Vector DB
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Worknet Open API
# 채용정보 API 인증키만 사용
WORKNET_API_KEY=
WORKNET_BASE_URL=https://www.work24.go.kr/cm/openApi/call/wk/callOpenApiSvcInfo210L01.do

# Django 시크릿 키 (아래 명령어로 생성) - 난수 생성
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# ============================================================
# 이메일 발송 (회원가입 환영 / 관리자 신규가입 알림 / 이메일 인증)
# 로컬 기본값은 console backend. 운영/QA 는 SMTP 로 전환.
# !! 실제 SMTP 비밀번호/앱 비밀번호는 .env.example 에 넣지 말 것. .env(미커밋)에만 입력.
# ============================================================
# 로컬 기본: django.core.mail.backends.console.EmailBackend
# 운영/QA:  django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Career.zip <no-reply@career.zip>

# 관리자 신규가입 알림 수신 주소 (예: admin@yourdomain)
ADMIN_NOTIFICATION_EMAIL=

# 이메일 인증 링크에 사용할 프론트엔드 base URL
FRONTEND_BASE_URL=http://localhost:5173

# 이메일 인증 토큰 만료(초) — 기본 24시간(86400)
EMAIL_VERIFICATION_TOKEN_MAX_AGE=86400

# QA seed 계정 비밀번호 (seed_qa_users 커맨드용) — .env(미커밋)에만 설정. 문서/코드에 실제 비밀번호 금지
QA_SEED_PASSWORD=

# ============================================================
# 이메일 발송 (회원가입 환영 / 관리자 신규가입 알림 / 이메일 인증)
# 로컬 기본값은 console backend. 운영/QA 는 SMTP 로 전환.
# !! 실제 SMTP 비밀번호/앱 비밀번호는 .env.example 에 넣지 말 것. .env(미커밋)에만 입력.
# 