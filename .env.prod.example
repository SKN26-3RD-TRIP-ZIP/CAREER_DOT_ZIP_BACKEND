# Career.zip Backend .env.prod 템플릿 — 값은 EC2/Secrets 에만. Git 커밋 금지!
# (.gitignore 가 .env.prod 를 이미 제외함을 확인하고 사용)
# --- 지금 확정 가능(도메인 무관) ---
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=__GENERATE__                 # python -c "from django.core.management.utils import get_random_secret_key as g;print(g())"
DATABASE_URL=mysql://<user>:<password>@<host>:3306/<database>
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=careerzip
OAUTH_EXCHANGE_CODE_TTL_SECONDS=120
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Career.zip <no-reply@career.zip>
PASSWORD_RESET_TIMEOUT=3600
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
OPENAI_API_KEY=<openai-api-key>
PINECONE_API_KEY=<pinecone-api-key>
PINECONE_INDEX_NAME=
AWS_S3_BUCKET_NAME=<bucket-name>
AWS_S3_REGION_NAME=<region-name>
AWS_ACCESS_KEY_ID=<optional-if-using-iam-role>
AWS_SECRET_ACCESS_KEY=<optional-if-using-iam-role>
VITE_API_BASE_URL=/api/v1

# --- DOMAIN_REQUIRED (최종 도메인 확정 후 채움) ---
ALLOWED_HOSTS=<DOMAIN_REQUIRED>
CORS_ALLOWED_ORIGINS=<DOMAIN_REQUIRED>
CSRF_TRUSTED_ORIGINS=<DOMAIN_REQUIRED>
FRONTEND_BASE_URL=<DOMAIN_REQUIRED>
GOOGLE_OAUTH_REDIRECT_URI=<DOMAIN_REQUIRED>
KAKAO_OAUTH_REDIRECT_URI=<DOMAIN_REQUIRED>
REFRESH_COOKIE_DOMAIN=<DOMAIN_REQUIRED>
REFRESH_COOKIE_SECURE=True
REFRESH_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BEHIND_PROXY=True
SECURE_SSL_REDIRECT=False
